{
  "name": "royakgameslab-launcher",
  "version": "1.1.1",
  "private": true,
  "description": "RoyakGamesLab multi-server game launcher platform.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "npm run setup:all && electron-builder --win",
    "setup:all": "npm install && npm run setup:ruffle",
    "publish:github": "npm run setup:all && electron-builder --win nsis --publish always",
    "setup:ruffle": "node scripts/install-ruffle.js"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "world.royakgames.lab.launcher",
    "productName": "RoyakGamesLab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "launcher-config.json",
      "package.json",
      "vendor/royakruffle/**/*"
    ],
    "extraResources": [
      {
        "from": "client",
        "to": "client"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "RoyakGamesLab-${version}-Setup.${ext}",
      "icon": "assets/royakgameslab.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RoyakGamesLab",
      "runAfterFinish": true,
      "artifactName": "RoyakGamesLab-${version}-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ValforWQA",
        "repo": "RoyakGamesLab",
        "releaseType": "release"
      }
    ],
    "asar": true
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.6.2",
    "@ruffle-rs/ruffle": "0.8.0-nightly.2026.10.29"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ValforWQA/RoyakGamesLab.git"
  },
  "homepage": "https://github.com/ValforWQA/RoyakGamesLab"
}
